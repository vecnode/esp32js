# physicalsim: XTENSA_SIM/XTENSA_VIRT/XTENSA_XTFPGA/XTENSA_ESP32S3 removed
# alongside their source files (hw/xtensa/meson.build's own comment) -
# only the board physicalsim's adapter actually launches stays configured.
config XTENSA_ESP32
    bool
    default y
    depends on XTENSA
    select SSI
    select SSI_M25P80
    select UNIMP
    select OPENCORES_ETH
    select DWC_SDMMC
    select TMP105
    select LED
    select ESP_RGB
    # I2C itself used to become true only as an accidental side effect of
    # unrelated ARM/PPC board Kconfig entries (hw/arm/Kconfig,
    # hw/ppc/Kconfig - both now removed) unconditionally selecting it -
    # explicit here instead. Genuinely needed: hw/i2c/meson.build only
    # pulls its whole i2c_ss (which esp32_i2c.c, the ESP32's own I2C bus
    # controller, is added to) into the build when CONFIG_I2C is set, and
    # esp32_machine_init_i2c() (hw/xtensa/esp32.c) attaches a real tmp105
    # temperature sensor to that bus.
    select I2C


